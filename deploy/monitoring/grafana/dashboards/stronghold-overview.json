    {
      "id": 12,
      "type": "timeseries",
      "title": "最近10秒事件循环 p95 / p99 / max",
      "description": "游戏每10秒独立窗口采样，不因抓取重置。正常约20ms定时分辨率含在结果中；窗口可能因阻塞延长。新服务器才提供。",
      "datasource": {
        "type": "prometheus",
        "uid": "stronghold-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sp_event_loop_window_p95_seconds{game=~\"$game\"} * 1000",
