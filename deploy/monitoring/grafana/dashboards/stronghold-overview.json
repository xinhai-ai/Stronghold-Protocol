    {
      "id": 13,
      "type": "timeseries",
      "title": "最近5分钟本机发送完成 p95 / p99",
      "description": "有界桶插值估计；每64次发送采样。本机压缩/排队/发送回调成功，不代表客户端收到或操作状态真正到达。零样本无数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "stronghold-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (game, le) (rate(sp_ws_send_completion_seconds_bucket{game=~\"$game\"}[5m]))) * 1000",
          "legendFormat": "p95 {{game}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99, sum by (game, le) (rate(sp_ws_send_completion_seconds_bucket{game=~\"$game\"}[5m]))) * 1000",
          "legendFormat": "p99 {{game}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "未采集 / 无样本",
          "color": {
            "mode": "palette-classic"
          }
