    {
      "id": 11,
      "type": "timeseries",
      "title": "匿名 WS ping RTT / 建连耗时",
      "description": "每10秒从监控容器新建匿名连接并ping一次，无hello/token/房间；监控点到目标的单次RTT，不是玩家RUM或操作状态p95。",
      "datasource": {
        "type": "prometheus",
        "uid": "stronghold-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sp_ws_probe_rtt_seconds{game=~\"$game\"} * 1000",
          "legendFormat": "ping RTT {{game}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
        },
        {
          "expr": "sp_ws_probe_connect_seconds{game=~\"$game\"} * 1000",
          "legendFormat": "建连（含可选 TLS）{{game}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "未采集 / 无样本",
          "color": {
            "mode": "palette-classic"
