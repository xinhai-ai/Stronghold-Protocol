            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
        },
        {
          "expr": "sp_event_loop_window_p99_seconds{game=~\"$game\"} * 1000",
          "legendFormat": "p99 {{game}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
