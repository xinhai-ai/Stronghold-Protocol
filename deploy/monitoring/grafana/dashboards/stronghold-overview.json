        {
          "expr": "sp_event_loop_window_max_seconds{game=~\"$game\"} * 1000",
          "legendFormat": "max {{game}}",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "stronghold-prometheus"
          },
          "instant": false
