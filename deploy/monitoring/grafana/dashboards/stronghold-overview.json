{
  "uid": "stronghold-platform",
  "title": "Stronghold 平台：延迟、资源与稳定性",
  "version": 1,
  "schemaVersion": 39,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "tags": [
    "stronghold",
    "websocket",
    "latency"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "game",
        "label": "游戏实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "stronghold-prometheus"
        },
        "query": {
          "query": "label_values(sp_target_up, game)",
          "refId": "game-variable"
        },
        "definition": "label_values(sp_target_up, game)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
