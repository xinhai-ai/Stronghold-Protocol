GRAFANA_ADMIN_USER=admin
# Replace this before starting. Never commit monitoring.env.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
# If reverse-proxied, set the actual HTTPS Grafana origin (independent from the game).
GRAFANA_ROOT_URL=http://localhost:3001
